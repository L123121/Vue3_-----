# Server runtime configuration
PORT=3000
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
JSON_BODY_LIMIT=2mb
TRUST_PROXY=false

# API protection
REQUIRE_API_AUTH=false
API_ACCESS_KEYS=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AI_RATE_LIMIT_WINDOW_MS=600000
AI_RATE_LIMIT_MAX=30

# Optional shared Agent sessions
REDIS_URL=
REDIS_SESSION_PREFIX=lowcode:agent:
SESSION_TTL_MS=1800000

# LLM and Agent budgets
LLM_REQUEST_TIMEOUT_MS=45000
AGENT_MAX_DURATION_MS=90000
AGENT_MAX_STEPS=12
AGENT_MAX_REPAIR_ROUNDS=2
AGENT_MAX_TOOL_ERRORS=3
AGENT_MUTATIONS_BEFORE_CONFIRM=5
AGENT_MAX_OUTPUT_TOKENS=1024
AGENT_MAX_CONTEXT_COMPONENTS=100
AGENT_MAX_SESSION_HISTORY=20
LEGACY_MAX_OUTPUT_TOKENS=4096
CHAT_MAX_OUTPUT_TOKENS=3072

# AI 页面生成（LLM 服务）
AI_API_KEY=
AI_BASE_URL=https://api.stepfun.com/step_plan/v1
AI_MODEL=step-3.7-flash

# AI 备用模型（OpenAI Chat Completions 兼容格式）
AI_FALLBACK_PROVIDER_NAME=longcat
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=https://api.longcat.chat/openai
AI_FALLBACK_MODEL=LongCat-2.0
